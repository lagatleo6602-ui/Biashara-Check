# Copy this file to .env and adjust if needed.
# XAMPP default: user root, empty password, port 3306.
DATABASE_URL=mysql+pymysql://root:@localhost:3306/sme_risk_db

# Only used to create the FIRST admin from the login page, when no admin exists yet.
# That admin becomes super admin. After that, new admins need a one-time code that the
# super admin generates on the Admin page (works once, expires after 24 hours).
ADMIN_SIGNUP_CODE=change-me-to-a-secret

# ---- Email (optional) ----
# Without these, verification and reset emails are printed in the server window instead of sent.
# For Gmail, use an "app password" (Google Account > Security > 2-Step Verification > App passwords).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# ---- SMS option 1: TextBee, free, sends from your own Android phone (optional) ----
# Install the TextBee app on the phone, sign in, then copy the API key from textbee.dev.
# If this is set, it's used instead of Africa's Talking.
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=

# ---- SMS option 2: Africa's Talking (optional) ----
# Without these, SMS are printed in the server window instead of sent.
# Free testing: AT_USERNAME=sandbox and the sandbox API key (messages show in the simulator only).
# Live: your live app username and API key, plus credit on the account.
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# ---- M-Pesa payments for Biashara Pro (optional) ----
# Without a consumer key the app runs in TEST mode: no prompt is sent, no money moves.
# Free testing: create an app at developer.safaricom.co.ke, copy its Consumer Key and Secret,
# keep MPESA_ENV=sandbox and leave SHORTCODE/PASSKEY empty (Safaricom's test Paybill 174379 is used).
# Sandbox payments always ask for KES 1.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_TILL=
# Callback: where Safaricom sends payment results. Not required: without it the app asks M-Pesa
# for the result while the owner waits. With ngrok running, it's found automatically.
# Your free ngrok address (ngrok dashboard > Domains), used by start-with-ngrok.bat:
NGROK_URL=
# Only set this to force a different public address than the one ngrok reports:
MPESA_CALLBACK_URL=
# Prices in KES
PRO_PRICE_MONTH=300
PRO_PRICE_YEAR=3000

# ---- Encryption key for emails and phone numbers (optional) ----
# Leave empty and the app creates instance/contact.key on first run. BACK THAT FILE UP:
# without it, saved emails and phone numbers can't be read.
CONTACT_KEY=

# ---- Messages and hosting ----
# Public address of the app, put in emails and SMS as a link (your ngrok address or your domain).
APP_URL=
# Monthly reminders to add last month's figures (2nd-10th of each month, after 9 am). Set to off to stop them.
REMINDERS=on
# Biashara Pro renewal notices (3 days before) and M-Pesa renewal prompts (1 day before), every 30 minutes. off to stop.
RENEWALS=on
# Set to true when the app is served over https (hosted online), so login cookies are only sent securely.
COOKIE_SECURE=false
